VISUALING DIFF EXP VISUALING DIFF EXP

#Now that we know which genes are differentially expressed for each of our contrasts, let’s visualise these results. After all, a table of thousands of p values and fold-changes is hard to interpret!

MA Plot

{r}

#MA PLOT
ma_plot_data <- tibble(
  logFC = efit$coefficients[, "ControlvsCase"],
  AvgExpr = efit$Amean,
  status = factor(as.numeric(dt[, "ControlvsCase"])),
  gene = new3$gene_name,
  p_value = efit$p.value[, "ControlvsCase"])

ma_plot_data_fct <- ma_plot_data %>%
  mutate(
    status = factor(
      status,
      levels = c(0, -1, 1),
      labels = c("Not DE", "Down", "Up")
    ))


top_de_genes <- ma_plot_data_fct %>%
  slice_min(n = 15, p_value) |> na.omit()

scale_cols <- c(
  "Not DE" = "black",
  "Down" = "#800080",
  "Up" = "#E30B5C"
)

#Plotting
ggplot(ma_plot_data_fct, aes(x = AvgExpr, y = logFC, col = status)) +
  geom_point(
    data = ma_plot_data_fct %>% filter(status == "Not DE"),
    size = 0.1
  )  +
  geom_point(data = ma_plot_data_fct %>% filter(status != "Not DE"), size = 3) +
  geom_label_repel(
    data = top_de_genes,
    aes(label = gene, col = NULL, size = 2),
    show.legend = FALSE
  ) +
  scale_colour_manual(values = scale_cols) +
  theme_classic() +
  labs(title = "MA plot for Case vs Control")

Volcano Plot

{r}
ggplot(ma_plot_data_fct, aes(x = logFC, y = -log10(p_value), col = status)) +
  geom_point(
    data = ma_plot_data_fct %>% filter(status == "Not DE"),
    size = 0.1
  ) +
  geom_point(data = ma_plot_data_fct %>% filter(status != "Not DE"), size = 1) +
  geom_label_repel(
    data = top_de_genes,
    aes(label = gene, col = NULL),
    max.overlaps = 20,
    show.legend = FALSE
  ) +
  scale_colour_manual(values = scale_cols) +
  theme_classic() +
  labs(title = "Volcano plot for Case vs Control")

